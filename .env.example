# Copy this file to .env and fill in real values for local development.
# In production, set these as environment variables/secrets on whichever
# platform hosts the web app and, separately, as GitHub repo secrets for
# the GitHub Actions worker (see .github/workflows/process_document.yml).

# --- Groq (Stage 3 pipeline LLM calls, and the direct /ask call) ---
GROQ_API_KEY=

# --- Gemini (Stage 4 image explanations, Stage 6 embeddings) ---
GEMINI_API_KEY=

# --- Qdrant (Stage 6 vector storage/retrieval) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=accessclass_lecture_chunks

# --- Supabase (document records, storage, revision queue) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=lectures

# --- Pipeline executor ---
# "thread" (default, local dev): main.py runs the full pipeline in-process
#   via a background thread. Requires requirements-worker.txt installed
#   (crewai, pymupdf, pytesseract, edge-tts, etc.) — not just requirements.txt.
# "github_actions": main.py only serves routes and dispatches the heavy
#   pipeline to a GitHub Actions job instead. Use this for deployment, with
#   just the slim requirements.txt installed. Requires GITHUB_TOKEN and
#   GITHUB_REPO below.
PIPELINE_EXECUTOR=thread

# --- Only needed when PIPELINE_EXECUTOR=github_actions ---
# A GitHub personal access token (fine-grained, scoped to this repo, with
# "Actions: read and write" permission) used to trigger the workflow.
GITHUB_TOKEN=
# "owner/repo", e.g. menahiln98/AccessClass
GITHUB_REPO=
